{
  "name": "dual-tetris",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm --workspace=@dual-tetris/server run dev",
    "dev:web": "npm --workspace=@dual-tetris/web run dev",
    "start": "npm --workspace=@dual-tetris/server run start",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:3000",
    "tunnel:ssh": "node scripts/tunnel.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
